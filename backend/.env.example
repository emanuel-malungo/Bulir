# ===== Server =====
PORT=3000

# ===== Database (Prisma) =====
DATABASE_URL="mysql://root:@localhost:3306/exemple_database"
DATABASE_HOST=localhost
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=exemple_database

# ===== JWT Authentication =====
