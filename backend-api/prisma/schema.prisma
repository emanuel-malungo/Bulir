// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())
  fullName String
  email String @unique
  nif String @unique
  passwordHash String
  balance Decimal @default(0.0) @db.Decimal(10,2)
  isActive Boolean @default(true)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles UserRole[]
  sessions Session[]
  servicesAsProvider Service[] @relation("ProviderServices")
  reservationsAsClient Reservation[] @relation("ClientReservations")

  @@index([email])
  @@index([deletedAt])
}

model Role {
  id Int @id @default(autoincrement())
  name String @unique
  description String

  rolePermissions RolePermission[]
  userRoles UserRole[]

  @@index([name])
}

model Permission {
  id Int @id @default(autoincrement())
  name String @unique
  description String

  rolePermissions RolePermission[]

  @@index([name])
}

model RolePermission {
  roleId Int
  permissionId Int

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Session {
  id Int @id @default(autoincrement())
  userId Int
  refreshToken String @unique
  userAgent String?
  ipAddress String?
  deviceId String?
  isRevoked Boolean @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Service {
  id Int @id @default(autoincrement())
  providerId Int
  name String
  description String?
  price Decimal @db.Decimal(10,2)
  isActive Boolean @default(true)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider User @relation("ProviderServices", fields: [providerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reservations Reservation[]

  @@index([providerId])
  @@index([isActive])
  @@index([deletedAt])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELED
}

model Reservation {
  id Int @id @default(autoincrement())
  clientId Int
  serviceId Int
  providerId Int
  status ReservationStatus @default(PENDING)
  scheduledAt DateTime
  
  // Snapshot do serviço no momento da reserva (evita inconsistência)
  serviceName String
  servicePrice Decimal @db.Decimal(10,2)
  
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client User @relation("ClientReservations", fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  history ReservationHistory[]

  @@index([clientId])
  @@index([serviceId])
  @@index([providerId])
  @@index([status])
  @@index([scheduledAt])
  @@index([clientId, status])
  @@index([serviceId, status])
  @@index([deletedAt])
}

model ReservationHistory {
  id Int @id @default(autoincrement())
  reservationId Int
  status ReservationStatus
  changedAt DateTime @default(now())
  deletedAt DateTime?

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([reservationId])
  @@index([changedAt])
  @@index([deletedAt])
}